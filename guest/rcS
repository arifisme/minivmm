#!/bin/sh
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /tmp
mount -o remount,rw /
hostname minivmm
ip link set lo up
if ip link show eth0 >/dev/null 2>&1; then
    ip addr add "${GUEST_IP:-172.16.0.2}/24" dev eth0
    ip link set eth0 up
    ip route add default via "${HOST_IP:-172.16.0.1}"
    dropbear -R -B -p 22
fi
echo "minivmm rootfs ready"
